{
  "method": "CumulantBasedLbMethod",
  "rates": {
    "1": "0.0",
    "x": "0.0",
    "y": "0.0",
    "z": "0.0",
    "x*y": "omega",
    "x*z": "omega",
    "y*z": "omega",
    "x**2 - y**2": "omega",
    "x**2 - z**2": "omega",
    "x**2 + y**2 + z**2": "1.0",
    "x*y**2 + x*z**2": "1.0",
    "x**2*y + y*z**2": "1.0",
    "x**2*z + y**2*z": "1.0",
    "x*y**2 - x*z**2": "1.0",
    "x**2*y - y*z**2": "1.0",
    "x**2*z - y**2*z": "1.0",
    "x*y*z": "1.0",
    "x**2*y**2 - 2*x**2*z**2 + y**2*z**2": "1.0",
    "x**2*y**2 + x**2*z**2 - 2*y**2*z**2": "1.0",
    "x**2*y**2 + x**2*z**2 + y**2*z**2": "1.0",
    "x**2*y*z": "1.0",
    "x*y**2*z": "1.0",
    "x*y*z**2": "1.0",
    "x**2*y**2*z": "1.0",
    "x**2*y*z**2": "1.0",
    "x*y**2*z**2": "1.0",
    "x**2*y**2*z**2": "1.0"
  },
  "rho_storage": "zero_centered",
  "uniform_other_rates_default": "1 per lbmpy 1.4 LBMConfig documentation",
  "uniform_bulk_damping_note": "Holding tau_bulk=1 across grid resolutions changes common-unit bulk viscosity proportional to dx^2/dt; not a measured material property of air"
}
